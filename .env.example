FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# SQLite em dev (padrão). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/condominio
DATABASE_URL=sqlite:///condominio.db
# Nome exibido no menu e no título das páginas
CONDOMINIO_NOME=Residencial Acácias
# Encargos por atraso (em %): multa única e juros ao mês (cobrados por dia)
MULTA_PERCENTUAL=2
JUROS_MENSAL_PERCENTUAL=1
